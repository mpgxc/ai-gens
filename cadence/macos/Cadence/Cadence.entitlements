<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Lets "Export history…" write where the user picks, and lets focus
	     music read the track or folder they choose. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- A chosen music file has to stay reachable after relaunch, which needs
	     a security-scoped bookmark rather than a stored path. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>

	<!-- Outbound only, and only for a focus-music stream URL the user pastes
	     in themselves. Cadence sends no telemetry and has no backend. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
