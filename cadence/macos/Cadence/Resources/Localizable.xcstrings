    "Music": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Música"
          }
        }
      }
    },
    "Music starts when a focus block starts and fades out when it ends — breaks stay quiet. A single track loops; a folder plays through.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A música começa junto com o bloco de foco e some no fim — as pausas ficam em silêncio. Uma faixa única entra em loop; uma pasta toca em sequência."
          }
        }
      }
    },
    "No music source selected.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma fonte de música selecionada."
          }
        }
      }
    },
