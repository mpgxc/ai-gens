    "Without permission, Cadence can still chime but cannot show phase-end alerts.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem permissão, o Cadence ainda toca o som, mas não consegue mostrar alertas de fim de fase."
          }
