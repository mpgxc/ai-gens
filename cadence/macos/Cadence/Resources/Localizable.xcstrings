{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ ready to start": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pronto para começar"
          }
        }
      }
    },
    "%@, %lld minutes remaining": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld minutos restantes"
          }
        }
      }
    },
    "%@, paused, %lld minutes remaining": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, pausado, %2$lld minutos restantes"
          }
        }
      }
    },
    "%lld minutes %lld seconds": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld minutos e %2$lld segundos"
          }
        }
      }
    },
    "%lld of %lld focus blocks": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld blocos de foco"
          }
        }
      }
    },
    "%lld seconds": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld segundos"
          }
        }
      }
    },
    "+5 minutes": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "+5 minutos"
          }
        }
      }
    },
    "A volume change takes effect on the next focus block, so it never jumps mid-session.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar o volume vale a partir do próximo bloco de foco, então ele nunca salta no meio da sessão."
          }
        }
      }
    },
    "Add 5 Minutes": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar 5 minutos"
          }
        }
      }
    },
    "Allow notifications": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir notificações"
          }
        }
      }
    },
    "Best day": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhor dia"
          }
        }
      }
    },
    "Break's over — back to it.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa encerrada — de volta ao trabalho."
          }
        }
      }
    },
    "Cadence can't open %@. Choose it again in Settings.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cadence não consegue abrir %@. Escolha novamente nos Ajustes."
